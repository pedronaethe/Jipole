# Polarized GRMHD snapshot test of the EHT polarized code comparison (arXiv:2303.12004,
# section 3.3): ipole's tests/sample_dump_mks/sample_dump_mks.par, with the defaults it
# relies on written out.
dump output/dump.h5
outfile output/ipole.h5
nx 160
ny 160

MBH 6.2e9
dsource 16.9e6
freqcgs 230.e9
M_unit 1.672e26

trat_small 3
trat_large 3
beta_crit 1
sigma_cut 1

rcam 1.e4
thetacam 163
phicam 0
rotcam 0
fovx_dsource 160
fovy_dsource 160

only_unpolarized 0
emission_type 4
counterjet 0
xoff 0
yoff 0
qu_conv 0
quench_output 0
add_ppm 0
