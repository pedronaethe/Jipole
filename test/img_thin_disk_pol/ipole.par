# Polarized thin-disk test of the EHT polarized code comparison (arXiv:2303.12004,
# section 3.2): ipole's tests/thin_disk/thin_disk.par. ipole is run from output/.

# Camera location for thin-disk comparison
rcam 1.e4
thetacam 75
phicam 0

# Camera FOV in r_g
dx 40
dy 40

# Image size
nx 80
ny 80

# Distance to source in pc
dsource 0.05

# Frequency corresponding to 1 keV photons
freqcgs 2.417989e17

# MBH in solar masses
MBH 10

# Accretion rate as fraction of Eddington
# (assuming 10% efficiency)
Mdot 0.01

# BH dimensionless spin
a 0.99

outfile ipole.h5
